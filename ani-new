#!/bin/sh

domain="https://anidb.app"
agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/15$(head /dev/urandom | tr -dc '0-2' | cut -c1).0.0.0 Safari/537.36"
logdir="${TMPDIR:-/tmp}/${0##*/}"

get_data() {
	curl -s "$1" -A "$agent" -e "${2:-$domain}"
}

search() {
	get_data "$domain/browse?sort=order_updated&q=$1" | sed -nE 's|.*/anime/([^"]*)".*anime-card.*|\1|p'
}

download() {
	case "$1" in
		*m3u8*)
			info_$os "Fetching Metadata"
			data=$(get_data "$1" "$3" | sed '/#/d')
			printf '%s' "$data" | nl -n'rz' | sed -E "s|^([0-9]*)[[:space:]]*(.*)|\2\n\tout=\1.ts|g" | aria2c --referer="$3" -U "$agent" -x16 -s16 -j50 -d "$logdir" -i - --download-result=hide --summary-interval=0 --allow-overwrite=true --check-certificate=false
			info_$os "Concatenating Pieces.."
			\cat "$logdir"/* | ffmpeg -loglevel error -stats -i - -c copy "$download_dir/$2.mp4" -y
			[ -d "$logdir" ] && rm -rdf "$logdir"
			;;
		*)
			aria2c --referer="$3" -U "$agent" --continue -x16 -s16 "$1" --dir="$download_dir" -o "$2.mp4" --download-result=hide --summary-interval=0 --allow-overwrite=true --check-certificate=false
			;;
	esac
	info_$os "Downloaded $2/$4"
}

[ "$1" = "search" ] && search "$2" && exit 0

case $(uname -o) in
	*ndroid*)
		os="droid"
		download_dir="/sdcard"
		;;
	*)
		os="linux"
		download_dir="${XDG_DOWNLOAD_DIR:-$HOME/Downloads}"
		;;
esac

. "$(dirname "$0")"/.functions

trap "exit 0" INT HUP
info_$os "Parsing $domain.. Please wait..."

url=$(search | (
	case "$os" in
		linux) menu_$os "Select Anime: " ;;
		*) fzf --bind="change:reload:$0 search '{q}'" --prompt="Select Anime: " ;;
	esac
)) || true

[ -z "$url" ] && error_$os "No anime selected" && exit 0

anime_id=$(printf '%s' "$url" | sed -nE 's|.*-([0-9]*)$|\1|p')
anime_name=$(printf '%s' "$url" | sed "s/-$anime_id//g;s/-/ /g")
refer="$domain/anime/$url"

info_$os "Loading Episodes list: $anime_name.."
ep=$(get_data "$domain/api/frontend/anime/$anime_id/episodes" "$refer" | sed 's/},{/\n/g' | sed -nE 's|.*"id":([0-9]*),"number":([0-9]*),.*|\2\t\1|p' | menu_$os "Select Episode: " "--with-nth=1")

[ -z "$ep" ] && error_$os "No episode selected" && exit 0

ep_id=$(printf '%s' "$ep" | cut -f2)
ep_number=$(printf "%s" "$ep" | cut -f1)
title="$anime_name episode $ep_number"

info_$os "Fetching Embed link: $title"
embed_url=$(get_data "$domain/api/frontend/episode/$ep_id/languages" "$refer" | sed -nE 's|.*"Japanese","embed_url":"(.*)"\}.*|\1|p' | sed 's/\\//g')

info_$os "Extracting Episode links.."
ep_m3u8_url=$(get_data "$embed_url" "$refer" | sed -nE "s|.*file: '([^']*)', type: 'hls'.*|\1|p")

ep_url=$(get_data "$ep_m3u8_url" "$refer" | tee data | sed '/EXT-X-I-FRAME/,$d' | sed "s|^#.*x||g; s|,.*|p|g; /^#/d; \$!N; s|\n| >|;/^$/d" | menu_$os "Select Resolution: " | cut -d'>' -f2)

[ -z "$ep_url" ] && error_$os "No Resolution selected" && exit 0

choice=$(printf "stream\ndownload\ncast" | menu_$os "??" '' "2")
[ -z "$choice" ] && exit 0

case $choice in
	stream)
		info_$os "opening $title" "mpv"
		# shellcheck disable=SC2086
		player_$os "$ep_url" "$title" --referrer="$refer" --tls-verify=no
		;;
	cast)
		info_$os "casting $title" "podcast"
		catt cast "$ep_url"
		;;
	download)
		info_$os "Downloading $title" "downloader"
		download "$ep_url" "$title" "$refer"
		info_$os "Episode Downloaded $title"
		;;
esac
